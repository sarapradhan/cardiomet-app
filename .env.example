SAHC_MODE=demo
# NHANES_DATA_DIR=data/raw
# ALLOWED_ORIGINS=https://your-domain.vercel.app
# Preview deployments get a new hostname on every build, so no exact-match list
# can cover them. Set a regex as well when you want previews to reach the API:
# ALLOWED_ORIGIN_REGEX=^https://<project>-[a-z0-9]+-<team>\.vercel\.app$
